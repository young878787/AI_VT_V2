# ============================================================
# AI routes: fill each route's key, URL, and model; no provider switch
# CHAT / MEMORY use OpenAI-compatible chat completions endpoints.
# Custom endpoints (remote vLLM) receive chat_template_kwargs.enable_thinking=false.
# Keep the served model alias in *_AI_MODEL; JEV retains its SystemOne format.
# JEV uses the OpenRouter SystemOne request format.
# ============================================================

# --- JEV ---
# JEV_AI_API_KEY may be blank when OPENROUTER_API_KEY is set.
OPENROUTER_API_KEY=
JEV_AI_API_KEY=
JEV_AI_BASE_URL=https://openrouter.ai/api/v1/systemone
JEV_AI_MODEL=jev-latest
JEV_TIMEOUT_SEC=2.0

# --- CHAT ---
CHAT_AI_API_KEY=
CHAT_AI_BASE_URL=https://api.openai.com/v1
CHAT_AI_MODEL=gpt-4o-mini

# --- MEMORY ---
MEMORY_AI_API_KEY=
MEMORY_AI_BASE_URL=https://api.openai.com/v1
MEMORY_AI_MODEL=gpt-4o-mini

# --- LONG-TERM MEMORY DATABASE (required for Alembic migration and DB runtime) ---
MEMORY_DATABASE_URL=
MEMORY_TEST_DATABASE_URL=
MEMORY_DATABASE_SCHEMA=ai_vt_memory
MEMORY_DEFAULT_USER_ID=
MEMORY_DEFAULT_CHARACTER_ID=
# 記憶圖書館管理 API 預設只允許 localhost；遠端部署前需先加入正式認證。
MEMORY_LIBRARY_LOCAL_ONLY=true

# --- EMBEDDING (separate from MEMORY_AI) ---
EMBEDDING_AI_API_KEY=local-vllm
EMBEDDING_AI_BASE_URL=http://127.0.0.1:18000/v1
EMBEDDING_AI_MODEL=jinaai/jina-embeddings-v5-text-small-retrieval
EMBEDDING_AI_SERVING_MODEL=jina-retrieval
EMBEDDING_AI_DIMENSION=1024
EMBEDDING_AI_QUERY_PREFIX="Query: "
EMBEDDING_AI_DOCUMENT_PREFIX="Document: "

# --- Local vLLM pooling server parameters ---
LOCAL_VLLM_RUNNER=pooling
LOCAL_VLLM_DTYPE=float16
LOCAL_VLLM_HOST=0.0.0.0
LOCAL_VLLM_PORT=18000
LOCAL_VLLM_MAX_MODEL_LEN=8192
LOCAL_VLLM_GPU_MEMORY_UTILIZATION=0.85
LOCAL_VLLM_MAX_NUM_SEQS=32
LOCAL_VLLM_TRUST_REMOTE_CODE=false
LOCAL_VLLM_SEQ_POOLING_TYPE=LAST
LOCAL_VLLM_USE_ACTIVATION=true
LOCAL_VLLM_MATRYOSHKA_DIMS=32,64,128,256,512,768,1024
LOCAL_VLLM_DEFAULT_DIM=1024

# Optional Qwen fallback model; used only for routes on a DashScope URL.
QWEN_FALLBACK_MODEL_NAME=

# 對話持久化（可選）
# true: 依 session_id 將 user/assistant 對話寫入 backend/memory/sessions
CHAT_PERSISTENCE_ENABLED=false
# 每個 session 最多保留訊息數（user+assistant）
CHAT_PERSISTENCE_MAX_MESSAGES=80
# 前端是否附帶 session_id（需與後端開關搭配）
VITE_CHAT_PERSISTENCE_ENABLED=false

# ============================================================
# Local Piper TTS Configuration
# ============================================================
# 是否啟用本地 Piper 語音合成；需要先放置模型與 .onnx.json
TTS_ENABLED=false

# ============================================================
# Voice Pipeline（即時語音輸入 / 本地語音輸出；引擎 port 自 voice_txt）
# 模型檔放置於 backend/models/（見 docs/2026-09-21-語音即時整合計劃.md）
# ============================================================
# --- ASR 語音輸入（sherpa-onnx 串流辨識 + Silero VAD）---
ASR_ENABLED=false
ASR_SAMPLE_RATE=16000
ASR_USE_AGC=true
ASR_SILENCE_SEC=1.2
# ASR_MODEL_DIR=backend/models/x-asr-zh-tw-en-streaming-ft75m
# VAD_MODEL_DIR=backend/models/silero-vad

# --- TTS 輸出：本地 Piper ONNX 推理 ---
PIPER_SPEAKER_ID=1
PIPER_LENGTH_SCALE=1.0
# PIPER_MODEL_PATH=backend/models/zh_TW-multi-voice.onnx

# ============================================================
# VTube Studio Configuration
# ============================================================
VTS_PLUGIN_NAME=VTS Tool
VTS_DEVELOPER=YourName
VTS_AUTH_TOKEN=

# ============================================================
# Server Configuratin
# ============================================================
BACKEND_PORT=9000
FRONTEND_PORT=5287
